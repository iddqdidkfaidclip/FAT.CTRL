# Локально (ollama напрямую):
# TRAINER_API_URL=http://127.0.0.1:11434/api/generate
# На VPS (ssh -R 127.0.0.1:18081:127.0.0.1:8080):
TRAINER_API_URL=http://127.0.0.1:18081/api/generate
TRAINER_MODEL=qwen2.5:7b

# Скачивание видео (YouTube / Instagram) — нужен yt-dlp + ffmpeg на сервере
# YouTube (2026+): ещё нужен Deno — curl -fsSL https://deno.land/install.sh | sh
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# YTDLP_JS_RUNTIME=deno:/home/user/.deno/bin/deno
# IG_COOKIES_PATH=/path/to/instagram_cookies.txt
# VIDEO_DOWNLOAD_DIR=./tmp/videos
# VIDEO_MAX_DURATION_SEC=3600
# VIDEO_MAX_DOWNLOAD_MB=200
