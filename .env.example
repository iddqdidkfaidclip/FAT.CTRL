# DeepSeek (ответы тренера + комментарии к новостям).
# Без AI_API_KEY тренер уходит в заглушку, новости — только заголовки.
AI_API_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
# AI_TIMEOUT_SEC=90

# Старый Ollama-путь больше не используется (оставлено для истории):
# TRAINER_API_URL=http://127.0.0.1:18081/api/generate
# TRAINER_MODEL=qwen3:4b
# TRAINER_NUM_PREDICT=1536

# Новости тренера (топ актуальных, Яндекс.Новости + RSS):
# NEWS_MAX_ITEMS=10
# NEWS_HTTP_TIMEOUT_SEC=30
# NEWS_YANDEX_API_URL=https://dzen.ru/api/v3/launcher/news?clid=300&country_code=ru
# NEWS_RSS_URLS=yandex://news,https://tass.ru/rss/v2.xml,https://ria.ru/export/rss2/index.xml
# NEWS_UA_GOOGLE_RSS_URL=https://news.google.com/rss?hl=uk&gl=UA&ceid=UA:uk
# NEWS_UA_RSS_URLS=https://news.google.com/rss?hl=uk&gl=UA&ceid=UA:uk,https://www.unian.ua/rss/news.xml,https://www.pravda.com.ua/rss/

# Скачивание видео (YouTube / Instagram) — на Ubuntu:
#   sudo apt update && sudo apt install -y yt-dlp ffmpeg gallery-dl
# (или свежее: sudo snap install gallery-dl → GALLERY_DL_PATH=/snap/bin/gallery-dl)
# YouTube (2026+): ещё Deno — curl -fsSL https://deno.land/install.sh | sh
# YTDLP_PATH=yt-dlp
# GALLERY_DL_PATH=gallery-dl
# FFMPEG_PATH=/usr/bin/ffmpeg
# YTDLP_JS_RUNTIME=deno:/home/user/.deno/bin/deno
# IG_COOKIES_PATH=/path/to/instagram_cookies.txt
# YTDLP_YT_COOKIES_PATH=/path/to/youtube_cookies.txt
#
# Обновление IG cookies на VPS (scripts/update_ig_cookies.sh):
# DEPLOY_SSH_HOST=
# DEPLOY_SSH_KEY=
# DEPLOY_SSH_USER=root
# IG_COOKIES_REMOTE_PATH=/etc/fatctrlbot/instagram_cookies.txt
# IG_COOKIES_BROWSER=chrome
# IG_COOKIES_TEST_URL=https://www.instagram.com/reel/...
# PIPED_API_URL=https://pipedapi.syncpundit.io
# VIDEO_DOWNLOAD_DIR=./tmp/videos
# VIDEO_MAX_DURATION_SEC=3600
# VIDEO_MAX_DOWNLOAD_MB=200
